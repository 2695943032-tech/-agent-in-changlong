# 直接填写 DeepSeek API Key 即可启用角色化对话和路线摘要。
# 这些配置只在 Nuxt 服务端读取，不会发送到浏览器。
NUXT_AI_API_KEY=
NUXT_AI_BASE_URL=https://api.deepseek.com
NUXT_AI_MODEL=deepseek-v4-flash
NUXT_AI_PROVIDER=deepseek
NUXT_AI_TIMEOUT_MS=8000

# 也可接入其他兼容 OpenAI Chat Completions 的服务：
# 修改 BASE_URL、MODEL、PROVIDER 和 API_KEY 即可。

# 游后票根“真实照片 → 高清 16-bit 像素纪念照”接口。
# 默认按 OpenAI-compatible Images Edits 协议发送 multipart/form-data；密钥只在服务端读取。
NUXT_IMAGE_API_KEY=
NUXT_IMAGE_BASE_URL=
NUXT_IMAGE_MODEL=gpt-image-2
NUXT_IMAGE_ENDPOINT=/images/edits
NUXT_IMAGE_TIMEOUT_MS=180000
