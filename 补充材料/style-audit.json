    {
      "para_index": 2,
      "text": "2026 AI \u5148\u950b\u672a\u6765\u4eba\u624d\u5927\u8d5b\uff5c\u957f\u9686\u96c6\u56e2\u547d\u9898",
      "style": "Normal"
    },
    {
      "para_index": 3,
